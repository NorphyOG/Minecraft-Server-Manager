<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MinecraftServerManager.Views.ConfirmDialog"
        Width="440"
        SizeToContent="Height"
        MinHeight="140"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,18,0,0">
            <Button Content="Nein"
                    MinWidth="88"
                    Click="OnNoClick" />
            <Button Content="Ja"
                    MinWidth="88"
                    Classes="app-action"
                    IsDefault="True"
                    Click="OnYesClick" />
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   MaxWidth="400"
                   FontSize="13" />
    </DockPanel>
</Window>
